    "settings": [
      {
        "id": "videoProvider",
        "type": "enum",
        "titleKey": "setting.videoProvider",
        "descriptionKey": "setting.videoProvider.description",
        "options": ["tsingfly", "openai", "custom"],
        "defaultValue": "tsingfly"
      },
      {
        "id": "videoApiBase",
        "type": "string",
        "titleKey": "setting.videoApiBase",
        "descriptionKey": "setting.videoApiBase.description",
        "defaultValue": "https://hub.tsingfly.com"
      },
      {
        "id": "videoApiKey",
        "type": "secret",
        "titleKey": "setting.videoApiKey",
        "descriptionKey": "setting.videoApiKey.description"
      },
      {
        "id": "outputDirectory",
        "type": "string",
        "titleKey": "setting.outputDirectory",
        "descriptionKey": "setting.outputDirectory.description",
        "defaultValue": "~/Movies/WillDeep Video Studio"
      },
      {
        "id": "ttsProvider",
        "type": "enum",
        "titleKey": "setting.ttsProvider",
        "descriptionKey": "setting.ttsProvider.description",
        "options": ["dashscope", "openai"],
        "defaultValue": "dashscope"
      },
      {
        "id": "ttsApiBase",
        "type": "string",
        "titleKey": "setting.ttsApiBase",
        "descriptionKey": "setting.ttsApiBase.description",
        "defaultValue": "https://dashscope.aliyuncs.com"
      },
      {
        "id": "ttsApiKey",
        "type": "secret",
        "titleKey": "setting.ttsApiKey",
        "descriptionKey": "setting.ttsApiKey.description"
      },
      {
        "id": "ttsModel",
        "type": "string",
        "titleKey": "setting.ttsModel",
        "descriptionKey": "setting.ttsModel.description",
        "defaultValue": "qwen3-tts-flash"
      },
      {
        "id": "musicProvider",
        "type": "enum",
        "titleKey": "setting.musicProvider",
        "descriptionKey": "setting.musicProvider.description",
        "options": ["none", "acestep"],
        "defaultValue": "none"
      },
      {
        "id": "musicApiBase",
        "type": "string",
        "titleKey": "setting.musicApiBase",
        "descriptionKey": "setting.musicApiBase.description",
        "defaultValue": "http://127.0.0.1:8001"
      }
    ]
